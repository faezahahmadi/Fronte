# Copy this file to .env and fill in your values.

# --- Django ---
# Any long random text. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-text
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Local PostgreSQL (what you use now) ---
DB_NAME=freshmart
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Cloud PostgreSQL (later) ---
# When you move to the cloud, paste the provider's connection string here.
# While DATABASE_URL has a value, the DB_* settings above are ignored.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Frontend ---
# Comma-separated addresses the frontend runs on (no trailing slash).
# 3000 = Next.js, 5173 = Vite
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
